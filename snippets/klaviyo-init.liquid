{% comment %}
  Klaviyo initialization snippet.
  Drop inside <head> after the viewport meta tag.

  Loads the Klaviyo JS SDK and identifies the current customer if logged in.
  The public API key is stored in theme settings (Online Store > Customize > Theme settings > Email Marketing).

  Identification:
  - Logged-in customers: identified by email via identify() call
  - Guests: identified on checkout via Klaviyo's native Shopify integration
{% endcomment %}

{% assign klaviyo_public_key = settings.klaviyo_public_key | strip %}
{% if klaviyo_public_key != blank %}
  <!-- Klaviyo -->
  <script
    async
    type="text/javascript"
    src="https://static.klaviyo.com/onsite/js/klaviyo.js?company_id={{ klaviyo_public_key }}"
  ></script>

  {% if customer %}
    <script>
      var _learnq = _learnq || [];
      _learnq.push(['identify', {
        '$email': {{ customer.email | json }},
        '$first_name': {{ customer.first_name | json }},
        '$last_name': {{ customer.last_name | json }},
        'shopify_customer_id': {{ customer.id | json }}
      }]);
    </script>
  {% endif %}
  <!-- End Klaviyo -->
{% endif %}
